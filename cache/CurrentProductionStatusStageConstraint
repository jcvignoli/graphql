{"data":{"__type":{"kind":"INPUT_OBJECT","name":"CurrentProductionStatusStageConstraint","description":"Example: if you want to match titles with production status stages\n('in_development' OR 'pre_production') AND NOT 'abandoned',\nspecify anyProductionStageIds: ['in_development', 'pre_production'], and excludeProductionStageIds: ['abandoned']\n\nIf both anyProductionStageIds and anyGranularProductionStageIds are specified, titles must match\nAT LEAST ONE from each list (AND logic between the two fields).","fields":null,"inputFields":[{"name":"anyGranularProductionStageIds","description":"Match titles with more granular production stage IDs.\nProduction stages are more fine-grained than the standard production stage IDs.\n\nExample: Standard stage 'in_development' may have granular stages like\n'script_development', 'financing', 'casting'.\n\nUse the PRODUCTION_STATUS facet to discover available granular stage IDs.","defaultValue":null,"type":{"kind":"LIST","name":null,"ofType":{"kind":"NON_NULL","name":null,"ofType":{"kind":"SCALAR","name":"ID","ofType":null}}}},{"name":"anyProductionStageIds","description":"A title match must contain AT LEAST ONE of these production status stages","defaultValue":null,"type":{"kind":"LIST","name":null,"ofType":{"kind":"NON_NULL","name":null,"ofType":{"kind":"SCALAR","name":"ID","ofType":null}}}},{"name":"excludeGranularProductionStageIds","description":"Exclude titles with more granular production stage IDs.\nProduction stages are more fine-grained than the standard production stage IDs.\n\nExample: Standard stage 'in_development' may have granular stages like\n'script_development', 'financing', 'casting'.\n\nUse the PRODUCTION_STATUS facet to discover available granular stage IDs.","defaultValue":null,"type":{"kind":"LIST","name":null,"ofType":{"kind":"NON_NULL","name":null,"ofType":{"kind":"SCALAR","name":"ID","ofType":null}}}},{"name":"excludeProductionStageIds","description":"A title match must contain NONE of these production