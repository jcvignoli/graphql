{"data":{"__type":{"kind":"INPUT_OBJECT","name":"WebAdTargetingParameters","description":"Parameters specific to web ad targeting","fields":null,"inputFields":[{"name":"extendedIds","description":"Extended IDs (eids) from CxM identity vendors (e.g. SharedID, ID5, Lotame, LiveRamp).\nUsed to pass 3P identity signals through to PAS for unified auction.\nIf not provided, no 3P identity signals will be forwarded to PAS and 3P buyers will rely\nsolely on their own cookie/ID matching for the impression.\n\nThese are generated client-side via CxM identity scripts. We treat these IDs as passthrough for PAS/AAX\n\nUp to four different identifiers present in this field at launch, with the possibility of a fifth\nlater on. There is no maximum array size\n\nExample:\nextendedIds: [\n  { source: \"pubcid.org\", userIds: [{ id: \"e52a-4033-b54c-f67d\", agentType: 1 }] },\n  { source: \"id5-sync.com\", userIds: [{ id: \"ID5-ZHMO_gMpLk...\", agentType: 1 }] },\n  { source: \"crwdcntrl.net\", userIds: [{ id: \"pan-id-abc123\", agentType: 1 }] },\n  { source: \"liveramp.com\", userIds: [{ id: \"AsvkAsvQTfYZ...\", agentType: 3 }] }\n]","defaultValue":null,"type":{"kind":"LIST","name":null,"ofType":{"kind":"NON_NULL","name":null,"ofType":{"kind":"INPUT_OBJECT","name":"AdExtendedId","ofType":null}}}},{"name":"isAbpAcceptable","description":"True if the client is requesting content that meets the AdBlockPlus Acceptable Ads program,\nfalse if the request is for standard ad content.","defaultValue":null,"type":{"kind":"NON_NULL","name":null,"ofType":{"kind":"SCALAR","name":"Boolean","ofType":null}}},{"name":"referrer","description":"Referrer URL that caused navigation to the current page (i.e. the page the user came from).\nCaptured by the web client from the page-navigation request's referer header (distinct from\nthe Zuko/GraphQL request's own referer) and passed through to site.ref in the OpenRTB bid\nrequest for third-party bidder targeting in the unified auction.\nIf not provided, site.ref will not be set.","defaultValue":null,"type":{"kind":"SCALAR","name":"URL","ofType":null}},{"name":"site","description":"The IMDb site variant on which the ads are intended to be shown","defaultValue":null,"type":{"kind":"NON_NULL","name":null,"ofType":{"kind":"ENUM","name":"AdSite","ofType":null}}},{"name":"slotSizeMap","description":"Mappings of requested ad slot names to requested ad slot sizes.\nRequired for non-mobile sites, but is optional in the schema.\nThe resolver is responsible for safely handling empty input.","defaultValue":null,"type":{"kind":"LIST","name":null,"ofType":{"kind":"NON_NULL","name":null,"ofType":{"kind":"INPUT_OBJECT","name":"SlotSize","ofType":null}}}},{"name":"url","description":"URL of the page being targeted.\nIf not provided, defaults to homepage URL corresponding to site field.","defaultValue":null,"type":{"kind":"SCALAR","name":"URL","ofType":null}}],"interfaces":null,"enumValues":null,"possibleTypes":null}},"extensions":{"disclaimer":"Public, commercial, and/or non-private use of the IMDb data provided by this API is not allowed. For limited non-commercial use of IMDb data and the associated requirements see https://help.imdb.com/article/imdb/general-information/can-i-use-imdb-data-in-my-software/G5JTRESSHJBBHTGX#"}}
