<?xml version="1.0"?>

	<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="IA gemini" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>GraphQL using WordPress rules</description>

	<file>web</file>
	<exclude-pattern>web/vendor/*</exclude-pattern>
	
	<!-- INFO: get list of rules availabe for PSR12: "./vendor/bin/phpcs -e DOUBLEDASHstandard=PSR12" -->

	<!-- Include the WordPress-Extra standard.-->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
		<exclude name="WordPress.PHP.IniSet.Risky"/>
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_exec"/>
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>

		<!-- I want to use short array [] -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!-- Yoda conditions to the bin, you go -->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Covers rule: Put spaces on both sides of the opening and closing parenthesis of
		 if, elseif, foreach, for, and switch blocks. I don't want it. -->
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<!-- Exclude those rules, specific to WordPress -->
		<exclude name="WordPress.Security.NonceVerification"/><!-- Suggests adding WP nonce verif -->
		<exclude name="WordPress.Security.EscapeOutput"/><!-- Suggests escaping with WP functions -->
		<exclude name="WordPress.Security.SafeRedirect"/><!-- Suggests WP safe page redirect -->
		<exclude name="WordPress.WP.EnqueuedResources"/><!-- Suggests enqueuing JS/CSS with WP functions -->
		<exclude name="WordPress.WP.EnqueuedResourceParameters"/><!-- Suggests enqueuing JS/CSS with WP functions -->
		<exclude name="WordPress.WP.GlobalVariablesOverride"/><!-- Doesn't want globals -->
		<exclude name="WordPress.WP.AlternativeFunctions"/><!-- Suggests WP functions -->
		<exclude name="WordPress.DateTime.RestrictedFunctions.timezone_change_date_default_timezone_set"/><!-- Using date_default_timezone_set() -->
		<exclude name="WordPress.PHP.IniSet.display_errors_Blacklisted" /><!-- I dont use WP functions -->
		<exclude name="WordPress.WhiteSpace.PrecisionAlignment.Found" /><!-- phpcbf can't fix it, so what's the point? -->
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_proc_open" /><!-- Used in webcrons for updating -->
		<exclude name="WordPress.DateTime.RestrictedFunctions.date_date" /><!-- I used date() instead of gmdate() -->
	</rule> 
</ruleset>
